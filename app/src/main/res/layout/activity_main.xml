<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/logo_title"
            android:textColor="@color/neon_cyan"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:shadowColor="@color/neon_cyan"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="26" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/logo_by"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.18" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:background="@color/neon_magenta" />

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card">

            <TextView
                android:id="@+id/textPairState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_paired"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/not_paired_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonScan"
            style="@style/Widget.Alfa.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/scan_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBackground"
            style="@style/Widget.Alfa.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/background_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUnpair"
            style="@style/Widget.Alfa.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:text="@string/unpair" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="@string/brand_footer"
            android:textColor="@color/neon_magenta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:shadowColor="@color/neon_magenta"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="18" />

    </LinearLayout>
</ScrollView>
