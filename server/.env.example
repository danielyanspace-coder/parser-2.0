# Скопируйте в .env и заполните своими значениями.
# Запуск с этим файлом:  set -a; . ./.env; set +a; node server.js

# Пароль резервной админки по адресу /admin (обязательно).
ADMIN_PASSWORD=ПРИДУМАЙТЕ_СЛОЖНЫЙ_ПАРОЛЬ

# Токен бота из BotFather. Если задан — подпись Telegram initData проверяется.
TELEGRAM_BOT_TOKEN=

# Telegram ID администратора (кому доступна админка в мини-аппе).
ADMIN_TG_ID=8211351879

# Публичный адрес сервиса (поддомен, чтобы не трогать основной сайт/VPN).
# Этот адрес зашивается в QR-код привязки.
PUBLIC_BASE_URL=https://sms.alfa-vpn.ru

# Порт локального Node-процесса (за nginx). Возьмите свободный, НЕ занятый VPN/старым ALFA SMS.
PORT=8090

# Номер получателя всех платёжных SMS (по умолчанию 7878).
RECIPIENT_NUMBER=7878

# Логин резервной админки (необязательно).
ADMIN_USER=admin
